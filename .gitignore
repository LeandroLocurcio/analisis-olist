# === Datos ===
# Los CSVs crudos son pesados (~125MB) y se bajan con src/download_data.py.
# Excepcion: los 2 que usa el dashboard en vivo (pages/1_Lead_Scoring.py) son chicos.
Datos/
data/*.csv
!data/olist_marketing_qualified_leads_dataset.csv
!data/olist_closed_deals_dataset.csv

# Datasets procesados por src/data.py -- versionados porque el dashboard los
# lee directo y pesan poco (~22MB); se regeneran corriendo el ETL igual.
data/processed/*
!data/processed/order_items_full.parquet
!data/processed/seller_features.parquet

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# === Entornos virtuales ===
.venv/
venv/
env/
ENV/

# === Jupyter ===
.ipynb_checkpoints/
*.nbconvert.ipynb

# === IDEs ===
.vscode/
.idea/
*.swp
*.swo

# === Sistema operativo ===
.DS_Store
Thumbs.db

# === Outputs generados ===
reports/figures/*.png
!reports/figures/.gitkeep
!reports/figures/data_model.png
models/*.pkl
!models/.gitkeep
!models/xgb_lead_scoring.pkl

# === Secrets ===
.env
*.key
kaggle.json
